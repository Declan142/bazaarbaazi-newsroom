# Newsroom-as-Code environment template
# Copy to .env and fill in your own values. Do NOT commit .env.

# ----- Required -----

# LLM provider keys (set at least one)
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Your site identity
NEWSROOM_HOST=example.com
NEWSROOM_ROOT=.

# ----- Data source (if your charts require login) -----

DATA_SOURCE_USER_ID=
DATA_SOURCE_PASSWORD=
DATA_SOURCE_TOTP_SECRET=
DATA_SOURCE_LOGIN_URL=https://your-broker.example.com/
DATA_SOURCE_HOME_REGEX=.*your-broker\.example\.com/(dashboard|chart).*

# CSV of instruments (symbol -> token map). Optional if your chart URLs
# do not require a token.
INSTRUMENTS_CSV_URL=
INSTRUMENTS_CACHE=./_runtime/cache/instruments.json

# Chart URL pattern (default works with TradingView-style symbols)
CHART_BASE_URL=https://www.tradingview.com/symbols
CHARTS_OUT_DIR=./public/charts

# Session storage for Playwright
SESSION_DIR=./_runtime/data-profile

# ----- LLM dispatch (optional) -----

OR_REFERER=https://example.com
OR_APP_TITLE=Newsroom Pipeline

# ----- Publishing (optional, depends on host) -----

# Cloudflare Pages
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_PAGES_PROJECT=

# Netlify
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
